# Kisaan Bharosa - Environment Configuration
# Copy to .env and fill in. Never commit .env.
APP_NAME="Kisaan Bharosa"
ENVIRONMENT="development"          # development | production (production enforces the checks below)
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# Security
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required in production: unique, at least 32 characters.
SECRET_KEY="kisaan-bharosa-dev-secret-change-me"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Allowed browser origins for the API, comma separated (no '*' in production)
CORS_ORIGINS="http://localhost:8000,http://127.0.0.1:8000"

# Staff account created on startup (password at least 12 characters, never logged).
# Portal sign-up always makes a farmer account; this is the only way to get inspector access.
BOOTSTRAP_INSPECTOR_EMAIL=""
BOOTSTRAP_INSPECTOR_PASSWORD=""
BOOTSTRAP_INSPECTOR_NAME="Quality Assurance Inspector"

# Database (SQLite for zero-config persistence; use PostgreSQL in production)
DATABASE_URL="sqlite:///./kisaan_bharosa.db"

# Google Gemini - required for real image analysis.
# Get a key at: https://aistudio.google.com/apikey
# With no key the API returns 503 ANALYSIS_UNAVAILABLE; the app never invents results.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_MODEL_FALLBACKS="gemini-2.5-flash,gemini-2.0-flash"
ANALYSIS_TIMEOUT_SECONDS=60
ANALYSIS_MAX_RETRIES=2

# Abuse protection for the billable analysis endpoint
ANALYSIS_RATE_LIMIT_REQUESTS=12
ANALYSIS_RATE_LIMIT_WINDOW_SECONDS=60

# Complaints may be filed without an account, so they carry their own cap
COMPLAINT_RATE_LIMIT_REQUESTS=5
COMPLAINT_RATE_LIMIT_WINDOW_SECONDS=600

MAX_UPLOAD_BYTES=15728640
UPLOAD_DIR="./static/uploads"

# Browser-run analysis (Puter.js). No key and no billing on your side: the visitor signs
# into Puter in their own browser and the model runs on their session. Set to false to
# forbid browser-supplied verdicts entirely.
PUTER_AI_ENABLED=true
PUTER_AI_MODEL=gpt-5.6-luna
